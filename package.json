{
  "name": "customer-support-chat-system",
  "version": "2.0.0",
  "description": "Customer Support Chat System — TypeScript, layered architecture, PostgreSQL",
  "private": true,
  "main": "dist/cmd/server.js",
  "scripts": {
    "dev": "tsx watch src/cmd/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cmd/server.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/cmd/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:layers": "tsx scripts/check-layers.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
